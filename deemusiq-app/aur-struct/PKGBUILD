# Maintainer: DeeMusiq <deemusiq@protonmail.com>
pkgname=deemusiq-bin
pkgver=%{{SPOTUBE_VERSION}}%
pkgrel=%{{PKGREL}}%
epoch=
pkgdesc="DeeMusiq — African music streaming and download platform. It's a drop day."
arch=(x86_64)
url="https://deemusiq.co.za"
license=('BSD-4-Clause')
groups=()
depends=('mpv' 'libappindicator-gtk3' 'libsecret' 'jsoncpp' 'libnotify' 'xdg-user-dirs' 'webkit2gtk-4.1')
makedepends=()
checkdepends=()
optdepends=('yt-dlp-git')
provides=('deemusiq')
conflicts=('deemusiq')
replaces=()
backup=()
options=()
install=
changelog=
source=("https://github.com/deemusiq/deemusiq/releases/download/v${pkgver}/deemusiq-linux-${pkgver}-x86_64.tar.xz")
noextract=()
md5sums=(%{{LINUX_MD5}}%)
validpgpkeys=()

package() {
  install -dm755 "${pkgdir}/usr/share/icons/deemusiq"
  install -dm755 "${pkgdir}/usr/share/applications"
  install -dm755 "${pkgdir}/usr/share/appdata"
  install -dm755 "${pkgdir}/usr/share/deemusiq"
  install -dm755 "${pkgdir}/usr/bin"

  mv ./deemusiq.desktop "${pkgdir}/usr/share/applications"
  mv ./deemusiq-logo.png "${pkgdir}/usr/share/icons/deemusiq/"
  mv ./com.deemusiq.deemusiq.appdata.xml "${pkgdir}/usr/share/appdata/com.deemusiq.deemusiq.appdata.xml"
  cp -ra ./data ./lib ./deemusiq "${pkgdir}/usr/share/deemusiq"
  ln -s "/usr/share/deemusiq/deemusiq" "${pkgdir}/usr/bin/deemusiq"
}
